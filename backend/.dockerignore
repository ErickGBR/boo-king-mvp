# Build context exclusions for ./Dockerfile (dev image used by docker-compose).
# The runtime disk (/app/data) and node_modules volume are mounted at run time.
node_modules
.env
.env.*
*.db
*.db-journal
*.db-wal
*.db-shm
npm-debug.log*
yarn-error.log*

# Rebuilt inside the image by `yarn build`; a stale local copy would be baked in.
dist

# Test/coverage artifacts must not ship in the image.
coverage
test/.tmp
test-results
