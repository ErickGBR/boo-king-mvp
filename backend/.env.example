DATABASE_URL="file:./prisma/dev.db"
JWT_SECRET=change-me-in-production
PORT=4000
NODE_ENV=development

# SMTP (emails de confirmación / reprogramación)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@boo-king.com

# --- Google OAuth2 ---
# Crea credenciales OAuth2 en Google Cloud Console (cliente "Web application").
# GOOGLE_CLIENT_ID y GOOGLE_CLIENT_SECRET se usan en el backend para:
#  1) Login con Google (flujo auth-code, redirect_uri=postmessage) — verificar ID token con audience estricto.
#  2) Calendar OAuth2 (conexión del calendario del dueño, access_type=offline).
# El frontend necesita la MISMA GOOGLE_CLIENT_ID como VITE_GOOGLE_CLIENT_ID
# (en frontend/.env.local). Sin ella, el botón de Google no se renderiza y el
# login email/password sigue funcionando.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Redirect URI registrado en Google Cloud Console para Calendar OAuth2.
GOOGLE_CALLBACK_URL=http://localhost:4000/api/google/callback
# Origen del frontend al que redirige el callback (connected / error / email_mismatch).
FRONTEND_URL=http://localhost:3000
